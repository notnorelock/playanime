# Server Configuration
PORT=3000
ENV=production

# Backend API
# Every route this server calls (anime/translators/profiles by slug,
# episodes by id, auth/me) is public or cookie-authenticated — there is no
# API key mechanism on the backend to configure here.
BACKEND_URL=http://localhost:4000

# Client Build Path
CLIENT_DIST_PATH=../../packages/web/dist

# Source Maps (only accessible by admins)
ENABLE_SOURCE_MAPS=true
