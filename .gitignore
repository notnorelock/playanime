# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
build/
out/
*.tsbuildinfo
.vite/

# Environment — never commit real secrets
.env
.env.*
!.env.example
!**/.env.example
# infrastructure/docker/.env.prod.example: a *.env.<name>.example still
# matches the .env.* ignore above (only the exact name ".env.example" is
# covered by the negation above it), so every such template needs its own
# negation here — don't assume a new one is automatically un-ignored.
!**/.env.prod.example
# Development defaults carry no secrets and make a fresh clone work as-is.
!.env.development

# Logs
logs/
*.log
npm-debug.log*
bun-debug.log*

# Test output
coverage/
.nyc_output/

# Local data
data/
*.sqlite
*.sqlite3

# Database backups — real production data, never committed.
infrastructure/docker/backups/

# autodeploy's real config (GitHub token, Discord bot token) and its
# persisted approval-workflow state — services/autodeploy.config.example.json
# is the only version-controlled copy.
services/autodeploy/autodeploy.config.json
services/autodeploy/autodeploy.state.json
services/autodeploy/autodeploy
services/autodeploy/autodeploy.exe

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Temp
tmp/
temp/
.cache/
