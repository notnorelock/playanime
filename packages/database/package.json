{
  "name": "@playanime/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./repositories": "./src/repositories/index.ts"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "bun run src/migrate.ts",
    "push": "drizzle-kit push",
    "studio": "drizzle-kit studio",
    "seed": "bun run src/seeds/index.ts"
  },
  "dependencies": {
    "@playanime/config": "workspace:*",
    "@playanime/contracts": "workspace:*",
    "@playanime/logger": "workspace:*",
    "@playanime/shared": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.6"
  }
}
