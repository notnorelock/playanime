{
  // exactOptionalPropertyTypes is disabled for this package only.
  //
  // Kobalte declares optional props as `prop?: T` rather than `prop?: T |
  // undefined`, so forwarding an optional prop through a wrapper — which every
  // component here does — is rejected under that flag. The alternative is
  // stripping undefined at ~40 call sites, which adds noise without adding
  // safety. Every other strict option stays on.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "src/**/*"
  ],
  "references": [
    {
      "path": "../shared"
    }
  ]
}
