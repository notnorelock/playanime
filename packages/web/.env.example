# Origin of the PlayAnime API, as the browser reaches it.
# No trailing slash, and no /api/v1 suffix — the client appends the version.
VITE_API_URL=http://localhost:4000

# Optional. Error reporting is disabled entirely when this is unset.
# VITE_SENTRY_DSN=

# Cloudflare Turnstile site key (public). Required — registration and the
# contact form both render a Turnstile widget and cannot submit without
# this. Pair with TURNSTILE_SECRET_KEY in the root .env.
VITE_TURNSTILE_SITE_KEY=
