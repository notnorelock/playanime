{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    // `unplugin-vue-router/client` declares the `definePage` compiler macro as
    // a global. Without it every view that calls one fails to typecheck, even
    // though the plugin compiles it away correctly at build time.
    "types": ["vite/client", "unplugin-vue-router/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noUncheckedIndexedAccess": true,
    "useUnknownInCatchVariables": true

    /*
     * `exactOptionalPropertyTypes` is deliberately off here, unlike in the
     * backend packages.
     *
     * Vue's `withDefaults` emits a defaults object containing `undefined` for
     * every prop that has no default, and the generated component props type
     * does not admit `undefined` on an optional prop. Every component using the
     * two together fails to typecheck through no fault of its own, and the only
     * workarounds are `| undefined` on props that genuinely are optional — which
     * defeats the point — or casts.
     *
     * The API layer still models absence precisely: its request builders omit
     * keys rather than sending `undefined`, and the contracts are typechecked
     * under the stricter setting in their own package.
     */
  },
  "references": [{ "path": "../contracts" }, { "path": "../player" }],
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "src/typed-router.d.ts", "env.d.ts"],

  /*
   * Watch Together is dormant.
   *
   * The UI exists and is worth keeping — it is the intended design — but there
   * is no backend for it: `@playanime/api` mounts no WebSocket server, so these
   * components reference endpoints and an auth token that no longer exist.
   * Nothing imports them (the route renders a "not available" page instead), so
   * they are excluded rather than rewritten against an API that isn't there.
   *
   * Remove these entries when the realtime transport is built; the contracts
   * and the `watch_parties` tables are already in place.
   */
  "exclude": [
    "src/components/features/WatchTogether/**",
    "src/components/player/composables/useWatchTogether.ts",
    "src/components/player/composables/useWatchTogetherPlayerSync.ts",
    "src/services/watchtogether.ts",
    "src/services/websocket.ts"
  ]
}
