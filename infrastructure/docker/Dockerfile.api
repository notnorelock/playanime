# syntax=docker/dockerfile:1.7
#
# PlayAnime API — production image.
#
# Multi-stage: dependencies, build, runtime. The runtime stage carries no
# toolchain and no source, which keeps the image small and removes the compiler
# from the attack surface.
#
# The Bun version is pinned to match package.json's own "packageManager"
# field exactly — a floating tag like 1.3-alpine drifts to whatever the
# latest 1.3.x is on any given day, and a newer Bun can disagree with an
# older one on how bun.lock resolves, which makes `bun install
# --frozen-lockfile` fail here even though the lockfile is fully in sync
# locally. Bump both together when you bump Bun.

# --- Dependencies -------------------------------------------------------------
FROM oven/bun:1.3.10-alpine AS deps
WORKDIR /app

# Manifests only, so this layer is cached until a dependency actually changes.
# Copying the whole tree here would invalidate it on every source edit.
#
# Every packages/* member's manifest is copied, including ones the API
# doesn't depend on (player, web) — package.json's "workspaces": ["packages/*"]
# is a glob Bun re-evaluates on install, and --frozen-lockfile compares that
# against what bun.lock recorded. A partial workspace (only the packages
# this image actually needs) looks like a changed lockfile to Bun, not a
# smaller one, and --frozen-lockfile refuses to proceed either way.
COPY package.json bun.lock ./
COPY packages/api/package.json packages/api/
COPY packages/auth/package.json packages/auth/
COPY packages/config/package.json packages/config/
COPY packages/contracts/package.json packages/contracts/
COPY packages/database/package.json packages/database/
COPY packages/email/package.json packages/email/
COPY packages/external-media/package.json packages/external-media/
COPY packages/importer/package.json packages/importer/
COPY packages/logger/package.json packages/logger/
COPY packages/realtime/package.json packages/realtime/
COPY packages/redis/package.json packages/redis/
COPY packages/shared/package.json packages/shared/
COPY packages/eslint-config/package.json packages/eslint-config/
COPY packages/player/package.json packages/player/
COPY packages/web/package.json packages/web/

RUN bun install --frozen-lockfile

# --- Build --------------------------------------------------------------------
FROM deps AS build
WORKDIR /app

COPY tsconfig.base.json tsconfig.json ./
COPY packages/ packages/

# Typecheck in the image as well as in CI: an image that cannot compile must not
# reach a registry, regardless of what CI did or did not run.
RUN bunx tsc --build packages/shared packages/contracts packages/config \
    packages/logger packages/database packages/redis packages/realtime

# --- Runtime ------------------------------------------------------------------
FROM oven/bun:1.3.10-alpine AS runtime
WORKDIR /app

ENV NODE_ENV=production

# Alpine's bun image ships a `bun` user; running as root would let a container
# escape become host root.
RUN apk add --no-cache curl tini

COPY --from=deps --chown=bun:bun /app/node_modules node_modules
COPY --from=build --chown=bun:bun /app/packages packages
COPY --chown=bun:bun package.json tsconfig.base.json tsconfig.json ./

USER bun

EXPOSE 4000

# The health endpoint queries Postgres and Redis, so an unhealthy dependency
# takes the container out of rotation rather than letting it serve errors.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://127.0.0.1:4000/api/v1/health || exit 1

# tini reaps zombies and forwards signals, so SIGTERM reaches Bun and the
# graceful shutdown path in server.ts actually runs.
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["bun", "run", "packages/api/src/main.ts"]
