# syntax=docker/dockerfile:1.7
#
# PlayAnime API — production image.
#
# Multi-stage: dependencies, build, runtime. The runtime stage carries no
# toolchain and no source, which keeps the image small and removes the compiler
# from the attack surface.

# --- Dependencies -------------------------------------------------------------
FROM oven/bun:1.3-alpine AS deps
WORKDIR /app

# Manifests only, so this layer is cached until a dependency actually changes.
# Copying the whole tree here would invalidate it on every source edit.
COPY package.json bun.lock ./
COPY packages/api/package.json packages/api/
COPY packages/auth/package.json packages/auth/
COPY packages/config/package.json packages/config/
COPY packages/contracts/package.json packages/contracts/
COPY packages/database/package.json packages/database/
COPY packages/external-media/package.json packages/external-media/
COPY packages/logger/package.json packages/logger/
COPY packages/redis/package.json packages/redis/
COPY packages/shared/package.json packages/shared/
COPY packages/eslint-config/package.json packages/eslint-config/

RUN bun install --frozen-lockfile

# --- Build --------------------------------------------------------------------
FROM deps AS build
WORKDIR /app

COPY tsconfig.base.json tsconfig.json ./
COPY packages/ packages/

# Typecheck in the image as well as in CI: an image that cannot compile must not
# reach a registry, regardless of what CI did or did not run.
RUN bunx tsc --build packages/shared packages/contracts packages/config \
    packages/logger packages/database packages/redis

# --- Runtime ------------------------------------------------------------------
FROM oven/bun:1.3-alpine AS runtime
WORKDIR /app

ENV NODE_ENV=production

# Alpine's bun image ships a `bun` user; running as root would let a container
# escape become host root.
RUN apk add --no-cache curl tini

COPY --from=deps --chown=bun:bun /app/node_modules node_modules
COPY --from=build --chown=bun:bun /app/packages packages
COPY --chown=bun:bun package.json tsconfig.base.json tsconfig.json ./

USER bun

EXPOSE 4000

# The health endpoint queries Postgres and Redis, so an unhealthy dependency
# takes the container out of rotation rather than letting it serve errors.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://127.0.0.1:4000/api/v1/health || exit 1

# tini reaps zombies and forwards signals, so SIGTERM reaches Bun and the
# graceful shutdown path in server.ts actually runs.
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["bun", "run", "packages/api/src/main.ts"]
