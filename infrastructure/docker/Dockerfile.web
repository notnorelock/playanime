# syntax=docker/dockerfile:1.7
#
# PlayAnime web — production image.
#
# Builds the static bundle, then serves it from nginx. The final image contains
# no JavaScript runtime at all: the app is HTML, CSS and JS on disk.

# --- Build --------------------------------------------------------------------
FROM oven/bun:1.3-alpine AS build
WORKDIR /app

COPY package.json bun.lock ./
COPY packages/web/package.json packages/web/
COPY packages/player/package.json packages/player/
COPY packages/contracts/package.json packages/contracts/
COPY packages/shared/package.json packages/shared/
COPY packages/config/package.json packages/config/
COPY packages/logger/package.json packages/logger/
COPY packages/database/package.json packages/database/
COPY packages/redis/package.json packages/redis/
COPY packages/auth/package.json packages/auth/
COPY packages/api/package.json packages/api/
COPY packages/external-media/package.json packages/external-media/
COPY packages/eslint-config/package.json packages/eslint-config/

RUN bun install --frozen-lockfile

COPY tsconfig.base.json tsconfig.json ./
COPY packages/ packages/

# The API origin is baked in at build time: Vite inlines VITE_ variables, so a
# bundle is environment-specific. Deploying the same bundle to staging and
# production requires either a build per environment or a runtime config fetch.
ARG VITE_API_URL=/api
ENV VITE_API_URL=${VITE_API_URL}

RUN bun run --filter '@playanime/web' build

# --- Runtime ------------------------------------------------------------------
FROM nginx:1.27-alpine AS runtime

RUN rm /etc/nginx/conf.d/default.conf
COPY infrastructure/nginx/web.conf /etc/nginx/conf.d/web.conf

COPY --from=build /app/packages/web/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -qO- http://127.0.0.1/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
