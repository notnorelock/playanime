# syntax=docker/dockerfile:1.7
#
# PlayAnime web — production image.
#
# Builds the static bundle, then serves it from nginx. The final image contains
# no JavaScript runtime at all: the app is HTML, CSS and JS on disk.
#
# Bun version pinned to match package.json's "packageManager" — see
# Dockerfile.api's longer comment on why a floating tag breaks
# --frozen-lockfile. Bump both together.

# --- Build --------------------------------------------------------------------
FROM oven/bun:1.3.10-alpine AS build
WORKDIR /app

# @playanime/external-media's `canvas` dependency (Byse device attestation —
# see Dockerfile.api's longer comment) is a native module node-gyp compiles
# at install time. This web image never uses it, but every workspace member's
# package.json is still copied below (required for --frozen-lockfile to see
# a consistent workspace, per Dockerfile.api's own comment on that), so
# `bun install` still tries to compile it here too without this toolchain.
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    pkgconf \
    cairo-dev \
    pango-dev \
    jpeg-dev \
    giflib-dev \
    librsvg-dev

COPY package.json bun.lock ./
COPY packages/web/package.json packages/web/
COPY packages/player/package.json packages/player/
COPY packages/contracts/package.json packages/contracts/
COPY packages/shared/package.json packages/shared/
COPY packages/config/package.json packages/config/
COPY packages/logger/package.json packages/logger/
COPY packages/database/package.json packages/database/
COPY packages/redis/package.json packages/redis/
COPY packages/realtime/package.json packages/realtime/
COPY packages/auth/package.json packages/auth/
COPY packages/api/package.json packages/api/
COPY packages/email/package.json packages/email/
COPY packages/external-media/package.json packages/external-media/
COPY packages/importer/package.json packages/importer/
COPY packages/eslint-config/package.json packages/eslint-config/

RUN bun install --frozen-lockfile

COPY tsconfig.base.json tsconfig.json ./
COPY packages/ packages/

# The API origin is baked in at build time: Vite inlines VITE_ variables, so a
# bundle is environment-specific. Deploying the same bundle to staging and
# production requires either a build per environment or a runtime config fetch.
#
# Empty, not "/api" — packages/web/src/api/client.ts's API_PREFIX already
# hardcodes "/api/v1" (matching the API's own route prefix, routes/v1.ts),
# so VITE_API_URL only needs to supply an origin when the API is on a
# different one. Same origin (the normal case here — nginx/webserver both
# proxy /api/* to the api container) means "" is correct: client.ts
# resolves the relative "/api/v1/..." request against window.location
# itself. A non-empty "/api" here doubles up into "/api/api/v1/...", which
# 404s against the real routes.
ARG VITE_API_URL=
ENV VITE_API_URL=${VITE_API_URL}

# Real git commit info, computed on the host by deploy.sh (which has a real
# .git checkout) and passed in here — this build context never has .git at
# all (.dockerignore excludes it deliberately), so packages/web's own
# `prebuild` (generate-version.js) has nothing to read `git rev-parse`
# from and would otherwise silently write the "dev"/"unknown"/commitCount 0
# fallback into every production version.json. All four empty is fine (the
# script falls through to its own git-command attempt, which fails the
# same way it always did, producing that same fallback) — not required to
# build, only to get a real version.json out of a Docker build specifically.
ARG GIT_COMMIT_HASH=
ARG GIT_COMMIT_COUNT=
ARG GIT_BRANCH=
ARG GIT_COMMIT_DATE=
ENV GIT_COMMIT_HASH=${GIT_COMMIT_HASH}
ENV GIT_COMMIT_COUNT=${GIT_COMMIT_COUNT}
ENV GIT_BRANCH=${GIT_BRANCH}
ENV GIT_COMMIT_DATE=${GIT_COMMIT_DATE}

RUN bun run --filter '@playanime/web' build

# --- Runtime ------------------------------------------------------------------
FROM nginx:1.27-alpine AS runtime

RUN rm /etc/nginx/conf.d/default.conf
COPY infrastructure/nginx/web.conf /etc/nginx/conf.d/web.conf

COPY --from=build /app/packages/web/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -qO- http://127.0.0.1/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
