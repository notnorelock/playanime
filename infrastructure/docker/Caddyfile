# PlayAnime — Caddy edge for the VPS deploy.
#
# Terminates TLS (automatic Let's Encrypt cert + renewal, zero extra setup)
# and reverse-proxies everything to `webserver` (services/webserver, the Go
# server — see docker-compose.prod.yml for why that one and not nginx/`web`).
# webserver already does the SPA fallback, the /api proxy to the api
# container, and its own gzip/cache headers — Caddy's job here is only TLS
# and being the single thing bound to :80/:443.

playani.me, www.playani.me {
	# www redirects to the bare domain rather than being a second serving
	# origin — one canonical URL for SEO, and it halves the cache/session
	# surface to reason about.
	@www host www.playani.me
	redir @www https://playani.me{uri} permanent

	# DNS for playani.me points at Cloudflare, so the peer Caddy actually
	# sees on every request is Cloudflare's edge, never the real visitor —
	# Cloudflare carries the real visitor IP in its own CF-Connecting-IP
	# header instead. That header would be trivially spoofable by anyone who
	# could reach Caddy directly, but install-vps.sh's ufw rules restrict
	# ports 80/443 to Cloudflare's published IP ranges specifically (see
	# CLOUDFLARE_IPS in that script) — nothing that isn't Cloudflare can
	# reach this port at all, so by the time a request arrives here,
	# CF-Connecting-IP can only be the value Cloudflare itself set. Caddy
	# forwards it through unchanged (reverse_proxy passes every header by
	# default); the api container reads it directly in preference to
	# X-Forwarded-For (see resolveClientIp in
	# packages/api/src/plugins/security.ts), which remains the fallback for
	# a local/non-Cloudflare deploy of this same stack.
	reverse_proxy webserver:3000

	encode gzip

	log {
		output file /data/access.log {
			roll_size 50mb
			roll_keep 5
		}
	}
}

# autodeploy's GitHub webhook listener (services/autodeploy/webhook) — a
# separate subdomain rather than a path under playani.me itself, since this
# is the deploy pipeline's own endpoint, not part of the app. autodeploy
# runs directly on the VPS host (systemd, see
# services/autodeploy/install.sh), outside Docker entirely — unlike
# webserver above, reverse_proxy can't reach it by container/service name,
# so this uses Docker's host-gateway sentinel (resolved via the caddy
# service's own extra_hosts in docker-compose.prod.yml) to reach the host's
# loopback interface from inside this container.
#
# TLS/firewall here work exactly like the block above: same Caddy
# container, same :80/:443 already restricted to Cloudflare's IP ranges
# (update-cloudflare-firewall.sh) — this subdomain needs its own DNS record
# in Cloudflare (proxied/orange-cloud, same as playani.me/www) but no
# firewall change. The actual security boundary for this endpoint is
# webhook.go's own HMAC-SHA256 signature check against the secret
# configured on the GitHub webhook — not IP-based trust.
ci.playani.me {
	reverse_proxy autodeploy-host:8787

	log {
		output file /data/access-ci.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
