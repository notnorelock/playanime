# Production environment for the VPS deploy. Copy to .env.prod (same
# directory) and fill in real values — .env.prod is gitignored, this
# example is the only copy that belongs in version control.
#
# Every variable here is read by packages/config/src/schema.ts, which
# refuses to boot in production if SESSION_SECRET still holds a dev
# placeholder, DATABASE_URL still has the default postgres:postgres
# credentials, or WEB_URL isn't https:// — so a mistake in this file
# mostly fails loudly at container start, not silently at runtime.
#
# For POSTGRES_PASSWORD and SESSION_SECRET specifically: run
# `bun run prod:secrets -- --write` instead of typing values in by hand —
# it generates both with real entropy and writes them (and the matching
# DATABASE_URL) directly into this file. See README.md in this directory
# for how to get the finished .env.prod onto the VPS without committing it.

NODE_ENV=production

# Public origins, as the browser and Discord's OAuth redirect see them —
# both must be your real domain over https, not the container-internal
# hostnames Caddy/Docker use to reach each other.
WEB_URL=https://playani.me
API_URL=https://playani.me/api

API_HOST=0.0.0.0
API_PORT=4000

# Set a real password — used two ways: POSTGRES_PASSWORD sets the actual
# database password (docker-compose.prod.yml overrides the base file's
# hardcoded dev "postgres" password with it), and DATABASE_URL below must
# repeat the same value so the api container's connection string matches.
# The default "postgres:postgres" in DATABASE_URL is rejected at boot in
# production regardless (see schema.ts) — this isn't optional to change.
#
# POSTGRES_PASSWORD only takes effect the first time Postgres initializes
# an empty data directory — a fresh VPS deploy (empty `playanime_pg`
# volume) picks it up correctly, but changing this value later, after the
# volume already exists, does nothing on its own. To rotate the password on
# an existing deploy, see README.md in this directory for the extra
# ALTER USER step that needs to go with it.
#
# This is published on 5432:5432 (see docker-compose.prod.yml) so Drizzle
# Studio/psql can reach it from outside the VPS — meaning this password is
# the only thing standing between the internet and the database. Use
# `bun run prod:secrets -- --write` (see the file header above) rather than
# typing something short here.
POSTGRES_PASSWORD=CHANGE_ME_TO_A_REAL_PASSWORD
DATABASE_URL=postgresql://postgres:CHANGE_ME_TO_A_REAL_PASSWORD@postgres:5432/playanime
DATABASE_POOL_MAX=10
DATABASE_SSL=false

REDIS_URL=redis://redis:6379
REDIS_NAMESPACE=playanime

SESSION_SECRET=CHANGE_ME_TO_48_BYTES_OF_REAL_RANDOMNESS
SESSION_TTL_DAYS=30
SESSION_COOKIE_NAME=playanime_session

# Caddy terminates TLS and forwards plain HTTP to webserver, adding one hop
# of X-Forwarded-For — this must match or rate limiting sees Caddy's IP for
# every request instead of the real client's.
TRUST_PROXY_HOPS=1

LOG_LEVEL=info
LOG_PRETTY=false

SOURCE_HEALTH_CHECKS_ENABLED=true

# Discord OAuth (optional — leave both unset to disable Discord login).
# Redirect URI to register: https://playani.me/api/v1/auth/discord/callback
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

