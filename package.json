{
  "name": "playanime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@playanime/api' --filter '@playanime/web' dev",
    "dev:api": "bun run --filter '@playanime/api' dev",
    "dev:web": "bun run --filter '@playanime/web' dev",
    "build": "bun run --filter '*' build",
    "preview": "bun run --filter '@playanime/web' build && bun run preview:server",
    "preview:server": "cd services/webserver && go run .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,json,md,scss,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,scss,css,yml,yaml}\"",
    "typecheck": "tsc --build --verbose && bun run --filter '@playanime/web' typecheck",
    "test": "bun test",
    "db:generate": "bun run --filter '@playanime/database' generate",
    "db:migrate": "bun run --filter '@playanime/database' migrate",
    "db:push": "bun run --filter '@playanime/database' push",
    "db:studio": "bun run --filter '@playanime/database' studio",
    "db:seed": "bun run --filter '@playanime/database' seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:reset": "docker compose down -v && docker compose up -d",
    "setup": "bun run scripts/setup-full-stack.ts",
    "prod:secrets": "bun run scripts/generate-prod-secrets.ts"
  },
  "devDependencies": {
    "@playanime/eslint-config": "workspace:*",
    "@types/bun": "^1.3.10",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
