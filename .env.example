NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
API_HOST=0.0.0.0
API_PORT=4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/playanime
DATABASE_POOL_MAX=10
DATABASE_SSL=false

REDIS_URL=redis://localhost:6379
REDIS_NAMESPACE=playanime

SESSION_SECRET=development-session-secret-change-me-please-32+
SESSION_TTL_DAYS=30
SESSION_COOKIE_NAME=playanime_session

LOG_LEVEL=info
LOG_PRETTY=true

SOURCE_HEALTH_CHECKS_ENABLED=false

# Discord OAuth. Create an app at https://discord.com/developers/applications,
# add a redirect URI of "<API_URL>/api/v1/auth/discord/callback", and paste
# its client id/secret below. Leave both unset to disable Discord login.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# DeepL API key, for live English-to-Polish translation of genre/tag names
# as they're created. Leave unset to disable — a new name is then stored
# without a Polish translation and the UI falls back to the English name.
# DEEPL_API_KEY=

# Resend API key, for outbound transactional email (currently just the
# takedown-report resolution notice to a reporter). Leave both unset to
# disable — the decision still applies, just without emailing the reporter.
# RESEND_API_KEY=
# RESEND_FROM_ADDRESS=

# Where the contact form sends its messages. Leave unset to disable the
# contact endpoint (it refuses with a clear error rather than discarding
# a message silently). Requires RESEND_API_KEY/RESEND_FROM_ADDRESS too.
# CONTACT_EMAIL=

# Signing secret for Resend's inbound-mail webhook (POST /api/v1/contact/webhook),
# from the webhook's page in the Resend dashboard once receiving is enabled
# for the domain. Leave unset to reject every webhook request rather than
# trusting an unverifiable one.
# RESEND_WEBHOOK_SECRET=

# Byse (see packages/external-media/src/providers/byse/README.md). Leave
# BYSE_API_KEY unset to disable the optional /get/domain and /file/info
# lookups — the documented iframe still plays normally either way.
# BYSE_API_BASE=https://api.byse.sx
# BYSE_API_KEY=
# BYSE_EMBED_LOGO_URL=

# Cloudflare Turnstile secret key, for verifying registration and the
# contact form. Required — both endpoints refuse every request while this
# is unset, unlike the optional integrations above. Get a site/secret key
# pair at https://dash.cloudflare.com/?to=/:account/turnstile. The matching
# public site key goes in packages/web/.env as VITE_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=
