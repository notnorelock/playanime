{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 110,
  "tabWidth": 2,
  "useTabs": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    { "files": "*.scss", "options": { "singleQuote": false } },
    { "files": "*.md", "options": { "proseWrap": "preserve" } }
  ]
}
